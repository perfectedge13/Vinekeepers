# Copy to .env and fill in values. Do not commit .env or real secrets.
# Discord: set env vars whose *names* match the keys in config/bots.yaml (discordTokenEnvKey per bot,
# or defaultDiscordTokenEnvKey). Example names below; use the same names as in your bots.yaml.
LUNA_DISCORD_TOKEN=your_luna_bot_token_here
ARRIETTY_DISCORD_TOKEN=your_arrietty_bot_token_here
GADGET_DISCORD_TOKEN=your_gadget_bot_token_here
CURSOR_API_KEY=your_cursor_api_key_here
CURSOR_API_BASE_URL=https://api.cursor.com
CURSOR_MODEL=
CURSOR_BASE_BRANCH=main
CURSOR_POLL_INTERVAL_MS=15000
# Optional: HTTP timeouts for Cursor Cloud API (adapter); omit for library defaults
CURSOR_HTTP_CONNECT_TIMEOUT_MS=
CURSOR_HTTP_REQUEST_TIMEOUT_MS=
# Emergency only: allow launch_cursor_run without persisted PlanApproval when contextId is set (default: gate on)
CURSOR_LAUNCH_SKIP_APPROVAL_GATE=false
# Optional: OpenAI-compatible API for planning synthesis (run_llm_planning_synthesis in arrietty_room). Omit key to skip LLM pass.
OPENAI_API_KEY=
# Preferred base URL alias (falls back to OPENAI_API_BASE_URL)
OPENAI_BASE_URL=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_PLANNING_MODEL=gpt-4o-mini
# Planning HTTP timeout (falls back to OPENAI_HTTP_REQUEST_TIMEOUT_MS)
OPENAI_PLANNING_TIMEOUT_MS=
OPENAI_HTTP_CONNECT_TIMEOUT_MS=
OPENAI_HTTP_REQUEST_TIMEOUT_MS=
GITHUB_TOKEN=
GITHUB_REPOS_PAGE_SIZE=25
GITHUB_EXCLUDE_ARCHIVED=true
# Optional: Luna repo workspace materialization (ensure_repo_workspace). Clone is off by default.
# When using the repo Dockerfile, the image defaults VINEKEEPERS_REPO_WORKSPACE_ROOT to /app/checkouts (omit or leave blank to use it).
VINEKEEPERS_REPO_WORKSPACE_ROOT=
VINEKEEPERS_ALLOW_GIT_CLONE=false
# When true, ensure_repo_workspace always reclones/refreshes instead of reusing an existing materialized checkout for the same context+ref.
VINEKEEPERS_REPO_WORKSPACE_FORCE_REFRESH=false
GIT_EXECUTABLE=git
# DevOps deploy manifest (default config/deploy-targets.yaml; legacy GADGET_PROJECTS_PATH still read)
DEPLOY_TARGETS_PATH=
GADGET_PROJECTS_PATH=
# Deploy bot / Ansible (DEPLOY_* preferred; GADGET_* aliases still read)
DEPLOY_ANSIBLE_ROOT=
DEPLOY_ANSIBLE_BINARY=
DEPLOY_ANSIBLE_INVENTORY=
DEPLOY_ANSIBLE_DISABLED=
DEPLOY_DEFAULT_PROJECT=
GADGET_ANSIBLE_ROOT=
GADGET_ANSIBLE_BINARY=ansible-playbook
GADGET_ANSIBLE_INVENTORY=
GADGET_ANSIBLE_DISABLED=false
# Example playbook ansible/playbooks/site.yml writes manifests here (default /tmp/gadget-deploy-staging)
GADGET_DEPLOY_STAGING=
GADGET_DEFAULT_PROJECT=
# Host Docker Compose ops (run_deploy_compose); disable all or tune timeouts / Discord line cap
DEPLOY_HOST_OPS_DISABLED=
GADGET_HOST_OPS_DISABLED=
DEPLOY_HOST_OPS_TIMEOUT_SECS=
DEPLOY_HOST_OPS_MAX_DISCORD_LINES=
DEPLOY_COMPOSE_BINARY=docker
DEPLOY_CURSOR_AGENT_BINARY=cursor
WIKIJS_URL=
WIKIJS_EMAIL=
WIKIJS_PASSWORD=
WIKIJS_API_KEY=
