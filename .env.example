# Copy to .env and fill in values. Do not commit .env or real secrets.
# Discord: set env vars whose *names* match the keys in config/bots.yaml (discordTokenEnvKey per bot,
# or defaultDiscordTokenEnvKey). Example names below; use the same names as in your bots.yaml.
LUNA_DISCORD_TOKEN=your_luna_bot_token_here
ARRIETTY_DISCORD_TOKEN=your_arrietty_bot_token_here
CURSOR_API_KEY=your_cursor_api_key_here
CURSOR_API_BASE_URL=https://api.cursor.com
CURSOR_MODEL=
CURSOR_BASE_BRANCH=main
CURSOR_POLL_INTERVAL_MS=15000
# Optional: HTTP timeouts for Cursor Cloud API (adapter); omit for library defaults
CURSOR_HTTP_CONNECT_TIMEOUT_MS=
CURSOR_HTTP_REQUEST_TIMEOUT_MS=
# Emergency only: allow launch_cursor_run without persisted PlanApproval when contextId is set (default: gate on)
CURSOR_LAUNCH_SKIP_APPROVAL_GATE=false
GITHUB_TOKEN=
GITHUB_REPOS_PAGE_SIZE=25
GITHUB_EXCLUDE_ARCHIVED=true
# Optional: Luna repo workspace materialization (ensure_repo_workspace). Clone is off by default.
# When using the repo Dockerfile, the image defaults VINEKEEPERS_REPO_WORKSPACE_ROOT to /app/checkouts (omit or leave blank to use it).
VINEKEEPERS_REPO_WORKSPACE_ROOT=
VINEKEEPERS_ALLOW_GIT_CLONE=false
GIT_EXECUTABLE=git
WIKIJS_URL=
WIKIJS_EMAIL=
WIKIJS_PASSWORD=
WIKIJS_API_KEY=
